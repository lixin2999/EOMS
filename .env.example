# ------------------- 应用 -------------------
EOMS_ENV=dev
EOMS_DEBUG=false
EOMS_SECRET_KEY=please-change-me-to-a-random-long-secret
EOMS_TIMEZONE=Asia/Shanghai
EOMS_TRUSTED_HOSTS=*

# ------------------- 数据库 -------------------
# 生产（docker compose 内）: postgresql+psycopg://eoms:eoms@db:5432/eoms
# 本地开发（无 PG 时留空，自动落 SQLite: .data/eoms.db）
EOMS_DATABASE_URL=
EOMS_DB_POOL_SIZE=20
EOMS_DB_MAX_OVERFLOW=10
EOMS_DB_POOL_TIMEOUT=10
EOMS_DB_STATEMENT_TIMEOUT_MS=15000
EOMS_RLS_ENABLED=true

# ------------------- Redis -------------------
EOMS_REDIS_URL=redis://redis:6379/0
# 本地无 Redis 时置空，自动降级为进程内缓存/锁（仅限开发）
EOMS_REDIS_TIMEOUT=2.0

# ------------------- 认证 -------------------
EOMS_ACCESS_TOKEN_MINUTES=30
EOMS_REFRESH_TOKEN_DAYS=3
EOMS_LOGIN_MAX_FAIL=5
EOMS_LOGIN_LOCK_MINUTES=15
EOMS_MAX_SESSIONS=3
EOMS_CAPTCHA_TTL=120
EOMS_PASSWORD_MIN_LENGTH=8
EOMS_PASSWORD_EXPIRE_DAYS=90

# ------------------- 会话 Cookie -------------------
# 浏览器会话走 HttpOnly Cookie + CSRF 双提交；HTTPS 环境必须置 true
EOMS_COOKIE_SECURE=false
# lax | strict | none
EOMS_COOKIE_SAMESITE=lax
# 留空表示当前域名；跨子域部署时填 .example.com
EOMS_COOKIE_DOMAIN=

# ------------------- 加密 -------------------
# 32 字节 base64 或 64 位 hex；留空时由 SECRET_KEY 派生（仅开发）
EOMS_AES_KEY=

# ------------------- 文件 -------------------
# minio | local
EOMS_STORAGE_BACKEND=minio
EOMS_MINIO_ENDPOINT=minio:9000
EOMS_MINIO_ACCESS_KEY=eoms
EOMS_MINIO_SECRET_KEY=eoms-minio-secret
EOMS_MINIO_BUCKET=eoms
EOMS_MINIO_SECURE=false
EOMS_LOCAL_STORAGE_DIR=.data/storage
EOMS_MAX_UPLOAD_MB=30
EOMS_PRESIGN_EXPIRE_SECONDS=900

# ------------------- 审批 -------------------
EOMS_WORKFLOW_DUE_HOURS=24
EOMS_WORKFLOW_LOCK_SECONDS=20
EOMS_BUDGET_ALERT_THRESHOLD=0.9

# ------------------- 通知 / 邮件 -------------------
EOMS_SMTP_HOST=
EOMS_SMTP_PORT=465
EOMS_SMTP_USER=
EOMS_SMTP_PASSWORD=
EOMS_SMTP_FROM=
EOMS_SMTP_SSL=true

# ------------------- Celery -------------------
EOMS_CELERY_BROKER_URL=redis://redis:6379/1
EOMS_CELERY_RESULT_BACKEND=redis://redis:6379/2
EOMS_CELERY_ALWAYS_EAGER=false

# ------------------- 前端 / CORS -------------------
EOMS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
EOMS_RATE_LIMIT_PER_MINUTE=300
EOMS_LOGIN_RATE_LIMIT_PER_MINUTE=10
EOMS_FILES_RATE_LIMIT_PER_MINUTE=60
EOMS_IDEMPOTENCY_TTL=86400
