# ---------------------------------------------------------------------------
# EOMS Docker 生产环境变量模板
# 推荐一键部署（自动生成全部密钥并启动）：
#   sudo bash deploy/install.sh
# 手动部署：
#   cp .env.docker.example .env
#   # 修改所有 CHANGE_ME 值后执行 docker compose up -d --build
# 严禁把真实 .env 提交到仓库；生产建议改用 Docker secrets / 外部 KMS。
# ---------------------------------------------------------------------------

# 监控组件（Prometheus/Grafana/Loki/Promtail）默认随一键部署启动；
# 不需要时删除本行或设置为空，可减少内存占用与启动时间。
COMPOSE_PROFILES=monitoring

# ----------------------------- 构建源 -----------------------------
# 国内服务器可使用以下镜像源（deploy/install.sh --cn-mirror 会自动写入）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# ----------------------------- 运行环境 -----------------------------
EOMS_ENV=prod
EOMS_DEBUG=false
EOMS_TIMEZONE=Asia/Shanghai
# 对外访问地址（用于 CORS 与 Grafana 根地址）
EOMS_PUBLIC_ORIGIN=http://localhost
EOMS_TRUSTED_HOSTS=*
HTTP_PORT=80

# ----------------------------- 密钥 -----------------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
EOMS_SECRET_KEY=CHANGE_ME_RANDOM_48_BYTES_STRING
# 32 字节 base64（生成：python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"）
EOMS_AES_KEY=CHANGE_ME_BASE64_32_BYTES

# ----------------------------- 数据库 -----------------------------
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
EOMS_DB_POOL_SIZE=20
EOMS_DB_MAX_OVERFLOW=10
EOMS_DB_POOL_TIMEOUT=10
EOMS_DB_STATEMENT_TIMEOUT_MS=15000
EOMS_RLS_ENABLED=true

# ----------------------------- 对象存储 -----------------------------
MINIO_ROOT_USER=eoms
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=eoms
EOMS_MAX_UPLOAD_MB=30

# ----------------------------- 认证 -----------------------------
EOMS_ACCESS_TOKEN_MINUTES=30
EOMS_REFRESH_TOKEN_DAYS=3
EOMS_LOGIN_MAX_FAIL=5
EOMS_LOGIN_LOCK_MINUTES=15
EOMS_MAX_SESSIONS=3
EOMS_CAPTCHA_TTL=120
EOMS_PASSWORD_MIN_LENGTH=8
EOMS_PASSWORD_EXPIRE_DAYS=90

# ----------------------------- 会话 Cookie -----------------------------
# 浏览器会话使用 HttpOnly Cookie + CSRF 双提交；HTTPS 部署必须为 true
# 仅内网 HTTP 试用时改为 false，否则浏览器不会回传 Cookie（表现为登录后立即掉线）
EOMS_COOKIE_SECURE=true
# lax | strict | none（跨站部署需 none，且必须配合 Secure）
EOMS_COOKIE_SAMESITE=lax
# 留空表示当前域名；跨子域部署时填 .example.com
EOMS_COOKIE_DOMAIN=

# ----------------------------- 审批 / 通知 -----------------------------
EOMS_WORKFLOW_DUE_HOURS=24
EOMS_WORKFLOW_LOCK_SECONDS=20
EOMS_BUDGET_ALERT_THRESHOLD=0.9
EOMS_SMTP_HOST=
EOMS_SMTP_PORT=465
EOMS_SMTP_USER=
EOMS_SMTP_PASSWORD=
EOMS_SMTP_FROM=
EOMS_SMTP_SSL=true

# ----------------------------- 限流 / 幂等 -----------------------------
EOMS_RATE_LIMIT_PER_MINUTE=300
EOMS_LOGIN_RATE_LIMIT_PER_MINUTE=10
EOMS_FILES_RATE_LIMIT_PER_MINUTE=60
EOMS_IDEMPOTENCY_TTL=86400

# ----------------------------- 可观测 -----------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3000

# ----------------------------- 初始化 -----------------------------
# 首次部署自动建演示数据（生产建议保持 false，使用 scripts/seed.py 受控执行）
EOMS_SEED_ON_START=false
